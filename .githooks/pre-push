#!/bin/sh
#
# Pollis: only main (and tags) may be pushed. Feature branches stay local.
#
# Deleting a remote branch is allowed, so stray branches can still be cleaned up.
# Bypass for a single push with `git push --no-verify`.

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
		refs/heads/main|refs/tags/*) ;;
		*)
			if [ "$local_sha" != "$zero" ]; then
				echo "pre-push: refusing to push $remote_ref; only main and tags are pushed." >&2
				status=1
			fi
			;;
	esac
done
exit $status
